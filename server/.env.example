# HTTP server
PORT=3333

# PostgreSQL connection string (local default matches compose.yml)
DATABASE_URL="postgresql://brevly:brevly@localhost:5432/brevly"

# Public URL of the web app: used as the allowed CORS origin and to build
# the shortened URLs written to the CSV report
WEB_URL="http://localhost:5173"

# Cloudflare R2 (S3-compatible) storage used for CSV reports
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET=""
CLOUDFLARE_PUBLIC_URL=""

# Optional: override the S3 endpoint (e.g. a local MinIO for testing).
# When empty, https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com is used.
CLOUDFLARE_ENDPOINT=""
